{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "CLERK_*",
        "DATABASE_URL",
        "BLOB_READ_WRITE_TOKEN",
        "CREDENTIALS_MASTER_KEYS",
        "CREDENTIALS_ACTIVE_KEY_ID",
        "CRUNCH_AI_GATEWAY",
        "AI_GATEWAY_API_KEY",
        "VERCEL_OIDC_TOKEN",
        "CRON_SECRET",
        "MIGRATE_ON_PREVIEW",
        "VERCEL_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    }
  }
}
