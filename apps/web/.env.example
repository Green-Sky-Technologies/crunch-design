# Copy to apps/web/.env.local for local development.

# --- Database (local: `pnpm db:up && pnpm db:migrate`; prod: Neon pooled URL) ---
DATABASE_URL=postgres://crunch:crunch@localhost:5433/crunch

# --- Clerk (dashboard.clerk.com → API keys). Leave unset locally to use Clerk keyless mode. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Credential encryption (generate with `pnpm keygen`) ---
# Comma-separated id:base64 pairs. New writes use CREDENTIALS_ACTIVE_KEY_ID (default: first entry).
CREDENTIALS_MASTER_KEYS=
CREDENTIALS_ACTIVE_KEY_ID=

# --- Bedrock role assumption (optional) ---
# Our AWS identity that assumes customers' roles. Credentials come from the standard AWS provider chain.
CRUNCH_AWS_PRINCIPAL_ARN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Vercel Blob (assets; Epic 2+) ---
BLOB_READ_WRITE_TOKEN=
