# Copy to apps/web/.env.local for local development. README.md → "Configuration" explains each
# variable. Or link the project to Vercel and run `vercel env pull` to get them all.

# --- Database (local: `pnpm db:up && pnpm db:migrate`) ---
DATABASE_URL=postgres://crunch:crunch@localhost:5433/crunch

# --- Clerk (dashboard.clerk.com → API keys), then run `pnpm setup:clerk` once ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Encryption for stored secrets: `openssl rand -base64 32` ---
CREDENTIALS_MASTER_KEYS=

# --- Models: Vercel AI Gateway ---
# On Vercel the deployment's OIDC token is used automatically. Locally, either run
# `vercel env pull` (writes VERCEL_OIDC_TOKEN), set an AI Gateway API key, or turn the gateway
# off and add a credential per workspace under Settings → Model access.
AI_GATEWAY_API_KEY=
# CRUNCH_AI_GATEWAY=off

# --- Vercel Blob (chat images, Figma image import) ---
BLOB_READ_WRITE_TOKEN=

# --- Optional ---
# CRON_SECRET=
# CRUNCH_AWS_PRINCIPAL_ARN=   # Bedrock role assumption only
