    "@crunch/crypto": "workspace:*",
    "@crunch/db": "workspace:*",
    "@crunch/doc-model": "workspace:*",
    "@crunch/ds-lint": "workspace:*",
    "@crunch/figma-convert": "workspace:*",
    "@crunch/handoff": "workspace:*",
    "@crunch/providers": "workspace:*",
    "@crunch/renderer": "workspace:*",
    "@crunch/sandbox-runner": "workspace:*",
